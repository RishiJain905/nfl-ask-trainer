# nfl-ask-trainer: variable NAMES only. Never put real values in this file.
# Copy to an env file next to it (git-ignored) and fill the values there yourself.

# Weights & Biases (optional here: `wandb login` inside the WSL venv works too, and the
# trainer then uses wandb's own stored login). Logged runs go to the NFL project.
WANDB_API_KEY=

# Hugging Face (optional: only for gated or private models; Spark-X2.6-4B is public)
HF_TOKEN=
